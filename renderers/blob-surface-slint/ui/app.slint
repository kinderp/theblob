import { BlobTheme } from "design/tokens.slint";
import { BlobWorld } from "screens/blob-world.slint";
import { ContextOverlay } from "components/context-overlay.slint";
import { BlobshBars } from "components/blobsh-bars.slint";

export component BlobShell inherits Window {
    in property <string> situation-summary;
    in property <string> task-status;
    in property <string> binding-summary;
    in property <string> verifier-summary;
    in property <string> execution-output;

    in property <string> romeo-action: "idle";
    in property <string> docs-action: "idle";
    in property <string> system-action: "idle";
    in property <string> notes-action: "idle";

    in property <bool> bluetooth-enabled: false;
    in property <string> bluetooth-label: "Bluetooth disabled";
    in property <string> pipewire-label: "PipeWire enabled";
    in property <string> printing-label: "Printing disabled";
    in property <bool> system-proposal-pending: false;
    in property <string> system-proposal-title: "";
    in property <string> system-proposal-summary: "";
    in property <string> system-proposal-diff: "";

    in property <int> focused-workspace: 0;
    in property <int> expanded-workspace: -1;
    in-out property <string> blob-style: "soft3d";

    in-out property <string> prompt-text: "";
    in property <string> prompt-status: "ask The Blob";
    in-out property <string> command-text: "";
    in property <string> command-level: "2/6 INTENT";
    in property <string> command-status: "preview";
    in-out property <bool> ai-bar-collapsed: false;
    in-out property <bool> command-bar-collapsed: false;

    in-out property <bool> copilot-open: false;
    in property <string> copilot-title: "Command Copilot";
    in property <string> copilot-body: "Edit the BLOB command directly or ask the AI for help.";
    in property <string> copilot-source: "Blobsh schema";
    in property <string> completion-1: "";
    in property <string> completion-2: "";
    in property <string> completion-3: "";

    in property <bool> overlay-open: false;
    in property <string> overlay-eyebrow: "TECHNICIAN";
    in property <string> overlay-title: "";
    in property <string> overlay-body: "";
    in property <string> overlay-detail: "";
    in property <string> overlay-status: "";

    callback activate-workspace(int);
    callback collapse-workspaces;
    callback explain-current;
    callback show-details;
    callback close-overlay;
    callback system-propose-bluetooth;
    callback system-clear-proposal;
    callback submit-prompt(string);
    callback submit-command(string);
    callback command-edited(string);
    callback completion-selected(string);
    callback ask-ai-about-command(string);
    callback command-shallower;
    callback command-deeper;

    title: "The Blob";
    width: 1440px;
    height: 900px;
    background: BlobTheme.canvas;

    default-font-family: "Menlo";
    default-font-size: 11px;
    default-font-weight: 400;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 30px;
            background: #070a0d;
            border-color: BlobTheme.border-soft;
            border-width: 1px;

            HorizontalLayout {
                padding-left: BlobTheme.space-3;
                padding-right: BlobTheme.space-3;
                spacing: BlobTheme.space-3;

                Text { text: "The Blob OS"; color: #65d69d; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Text { text: "|  P0"; color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text {
                    text: "|  workspace: " + (root.focused-workspace == 0 ? "1 Romeo" : root.focused-workspace == 1 ? "2 Docs" : root.focused-workspace == 2 ? "3 System" : "4 Notes");
                    color: BlobTheme.text;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Text { text: "|  shell: blobsh"; color: BlobTheme.text-muted; font-size: 9px; vertical-alignment: center; }
                Text { text: "|  session: main"; color: BlobTheme.text-muted; font-size: 9px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: "fabric 1"; color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: "host local"; color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: "authority user"; color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
            }
        }

        Rectangle {
            height: 29px;
            background: #0b0f13;
            border-color: BlobTheme.border-soft;
            border-width: 1px;

            HorizontalLayout {
                padding-left: BlobTheme.space-3;
                padding-right: BlobTheme.space-3;
                spacing: BlobTheme.space-4;

                Text { text: root.focused-workspace == 0 ? "1:Romeo*" : "1:Romeo"; color: root.focused-workspace == 0 ? BlobTheme.dev : BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: root.focused-workspace == 1 ? "2:Docs*" : "2:Docs"; color: root.focused-workspace == 1 ? BlobTheme.docs : BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: root.focused-workspace == 2 ? "3:System*" : "3:System"; color: root.focused-workspace == 2 ? BlobTheme.system : BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: root.focused-workspace == 3 ? "4:Notes*" : "4:Notes"; color: root.focused-workspace == 3 ? BlobTheme.notes : BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }

                Text {
                    text: "[3D]";
                    color: root.blob-style == "soft3d" ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 9px;
                    font-weight: root.blob-style == "soft3d" ? 600 : 400;
                    vertical-alignment: center;
                    three-d-touch := TouchArea { mouse-cursor: pointer; clicked => { root.blob-style = "soft3d"; } }
                }
                Text {
                    text: "[PIXEL]";
                    color: root.blob-style == "pixel" ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 9px;
                    font-weight: root.blob-style == "pixel" ? 600 : 400;
                    vertical-alignment: center;
                    pixel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.blob-style = "pixel"; } }
                }
                Text {
                    text: "[ASCII]";
                    color: root.blob-style == "ascii" ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 9px;
                    font-weight: root.blob-style == "ascii" ? 600 : 400;
                    vertical-alignment: center;
                    ascii-touch := TouchArea { mouse-cursor: pointer; clicked => { root.blob-style = "ascii"; } }
                }

                Text { text: "mode: " + (root.expanded-workspace < 0 ? "world" : "world+surfaces"); color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: "surface-host: slint"; color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
                Text { text: "placement: local"; color: BlobTheme.text-faint; font-size: 9px; vertical-alignment: center; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: BlobTheme.canvas;

            BlobWorld {
                focused-workspace: root.focused-workspace;
                expanded-workspace: root.expanded-workspace;
                blob-style: root.blob-style;
                romeo-action: root.romeo-action;
                docs-action: root.docs-action;
                system-action: root.system-action;
                notes-action: root.notes-action;
                situation-summary: root.situation-summary;
                task-status: root.task-status;
                binding-summary: root.binding-summary;
                verifier-summary: root.verifier-summary;
                execution-output: root.execution-output;
                bluetooth-enabled: root.bluetooth-enabled;
                bluetooth-label: root.bluetooth-label;
                pipewire-label: root.pipewire-label;
                printing-label: root.printing-label;
                proposal-pending: root.system-proposal-pending;
                proposal-title: root.system-proposal-title;
                proposal-summary: root.system-proposal-summary;
                proposal-diff: root.system-proposal-diff;
                activate-workspace(index) => { root.activate-workspace(index); }
                collapse-workspaces => { root.collapse-workspaces(); }
                system-propose-bluetooth => { root.system-propose-bluetooth(); }
                system-clear-proposal => { root.system-clear-proposal(); }
                explain-current => { root.explain-current(); }
                show-details => { root.show-details(); }
            }

            if root.overlay-open: Rectangle {
                background: #00000077;
                ContextOverlay {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    eyebrow: root.overlay-eyebrow;
                    title: root.overlay-title;
                    body: root.overlay-body;
                    detail: root.overlay-detail;
                    status: root.overlay-status;
                    close => { root.close-overlay(); }
                }
            }
        }

        BlobshBars {
            prompt-text <=> root.prompt-text;
            prompt-status: root.prompt-status;
            command-text <=> root.command-text;
            command-level: root.command-level;
            command-status: root.command-status;
            ai-collapsed <=> root.ai-bar-collapsed;
            command-collapsed <=> root.command-bar-collapsed;
            copilot-open <=> root.copilot-open;
            copilot-title: root.copilot-title;
            copilot-body: root.copilot-body;
            copilot-source: root.copilot-source;
            completion-1: root.completion-1;
            completion-2: root.completion-2;
            completion-3: root.completion-3;
            submit-prompt(text) => { root.submit-prompt(text); }
            submit-command(text) => { root.submit-command(text); }
            command-edited(text) => { root.command-edited(text); }
            completion-selected(text) => { root.completion-selected(text); }
            ask-ai-about-command(text) => { root.ask-ai-about-command(text); }
            command-shallower => { root.command-shallower(); }
            command-deeper => { root.command-deeper(); }
        }
    }
}
