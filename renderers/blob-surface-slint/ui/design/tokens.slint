export global BlobTheme {
    // Reversible P0 experiment: Arch/terminal-like dark baseline.
    // Almost-black neutral surfaces, Arch-blue punctuation and low saturation
    // keep the Shell technical without turning it into a neon dashboard.
    in-out property <color> canvas: #0c0f12;
    in-out property <color> surface: #11151a;
    in-out property <color> surface-raised: #171c22;
    in-out property <color> surface-soft: #14191f;
    in-out property <color> border: #28313a;
    in-out property <color> border-soft: #202831;
    in-out property <color> glow-soft: #18232b;

    in-out property <color> text: #c8d0d8;
    in-out property <color> text-muted: #8b949e;
    in-out property <color> text-faint: #59636e;
    in-out property <color> ink: #15191d;

    // Arch-blue is the primary shell punctuation; status colours remain muted.
    in-out property <color> accent: #1793d1;
    in-out property <color> accent-secondary: #8f7cec;
    in-out property <color> accent-soft: #132a38;
    in-out property <color> success: #7fbf7f;
    in-out property <color> success-soft: #17271c;
    in-out property <color> warning: #d3a95f;
    in-out property <color> warning-soft: #302718;
    in-out property <color> danger: #d76a6a;

    // Workspace identity lives mainly on the characters.
    in-out property <color> dev: #d3a95f;
    in-out property <color> docs: #4fb7a7;
    in-out property <color> system: #7fbf7f;
    in-out property <color> notes: #ad7bc4;
    in-out property <color> terminal: #7fbf7f;
    in-out property <color> helmet: #d8b66b;
    in-out property <color> helmet-dark: #a77f39;
    in-out property <color> eye: #eef2f4;
    in-out property <color> cheek: #d77a8560;

    in-out property <length> space-1: 4px;
    in-out property <length> space-2: 8px;
    in-out property <length> space-3: 12px;
    in-out property <length> space-4: 16px;
    in-out property <length> space-5: 20px;
    in-out property <length> space-6: 24px;
    in-out property <length> space-8: 32px;
    in-out property <length> space-10: 40px;

    in-out property <length> radius-sm: 2px;
    in-out property <length> radius-md: 3px;
    in-out property <length> radius-lg: 4px;
    in-out property <length> radius-xl: 5px;

    in-out property <length> rail-width: 188px;
    in-out property <length> technician-width: 340px;
    in-out property <length> header-height: 36px;
    in-out property <length> prompt-height: 48px;
}
