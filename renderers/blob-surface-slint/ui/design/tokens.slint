export global BlobTheme {
    // P0 default visual baseline: familiar editor-dark ergonomics.
    // Deliberately more neutral than the earlier neon shell so the information
    // UI can stay open for long programming and system-administration sessions.
    in-out property <color> canvas: #1e1e1e;
    in-out property <color> surface: #252526;
    in-out property <color> surface-raised: #2d2d30;
    in-out property <color> surface-soft: #232326;
    in-out property <color> border: #3c3c3c;
    in-out property <color> border-soft: #313136;
    in-out property <color> glow-soft: #2a2d31;

    in-out property <color> text: #d4d4d4;
    in-out property <color> text-muted: #a7a7a7;
    in-out property <color> text-faint: #777777;
    in-out property <color> ink: #202124;

    // Familiar editor/terminal-style semantic accents. Colour is punctuation,
    // not the background language of the shell.
    in-out property <color> accent: #569cd6;
    in-out property <color> accent-secondary: #c586c0;
    in-out property <color> accent-soft: #263645;
    in-out property <color> success: #6a9955;
    in-out property <color> success-soft: #243126;
    in-out property <color> warning: #d7ba7d;
    in-out property <color> warning-soft: #3a3224;
    in-out property <color> danger: #f48771;

    // Workspace identity is concentrated in the characters, not large panels.
    in-out property <color> dev: #d7ba7d;
    in-out property <color> docs: #4ec9b0;
    in-out property <color> system: #b5cea8;
    in-out property <color> notes: #c586c0;
    in-out property <color> terminal: #b5cea8;
    in-out property <color> helmet: #e5c07b;
    in-out property <color> helmet-dark: #b89552;
    in-out property <color> eye: #f2f2f2;
    in-out property <color> cheek: #e58b9866;

    in-out property <length> space-1: 4px;
    in-out property <length> space-2: 8px;
    in-out property <length> space-3: 12px;
    in-out property <length> space-4: 16px;
    in-out property <length> space-5: 20px;
    in-out property <length> space-6: 24px;
    in-out property <length> space-8: 32px;
    in-out property <length> space-10: 40px;

    in-out property <length> radius-sm: 3px;
    in-out property <length> radius-md: 5px;
    in-out property <length> radius-lg: 6px;
    in-out property <length> radius-xl: 8px;

    in-out property <length> rail-width: 188px;
    in-out property <length> technician-width: 340px;
    in-out property <length> header-height: 38px;
    in-out property <length> prompt-height: 52px;
}
