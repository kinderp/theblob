import { BlobTheme } from "../design/tokens.slint";

export component AsciiBlobAvatar inherits Rectangle {
    in property <string> name;
    in property <string> role;
    in property <string> status;
    in property <string> accessory;
    in property <color> blob-color;
    in property <bool> focused: false;
    callback activated;

    property <bool> frame-two: false;
    property <bool> blinking: false;
    property <bool> gesture: false;

    width: 224px;
    height: 250px;
    background: transparent;

    Timer {
        interval: root.focused ? 820ms : 1500ms;
        running: true;
        triggered() => { root.frame-two = !root.frame-two; }
    }
    Timer {
        interval: root.accessory == "helmet" ? 3800ms : root.accessory == "glasses" ? 4500ms : root.accessory == "wrench" ? 4200ms : 5000ms;
        running: true;
        triggered() => { root.blinking = true; }
    }
    Timer { interval: 110ms; running: root.blinking; triggered() => { root.blinking = false; } }
    Timer {
        interval: root.accessory == "helmet" ? 7300ms : root.accessory == "glasses" ? 8200ms : root.accessory == "wrench" ? 7800ms : 9000ms;
        running: true;
        triggered() => { root.gesture = true; }
    }
    Timer { interval: 650ms; running: root.gesture; triggered() => { root.gesture = false; } }

    if root.focused: Rectangle {
        x: 8px;
        y: 10px;
        width: 208px;
        height: 198px;
        background: #0a1116;
        border-color: BlobTheme.accent;
        border-width: 1px;
    }

    Text {
        x: 12px;
        y: root.frame-two ? 22px : 26px;
        width: 200px;
        height: 162px;
        text: root.accessory == "helmet" ?
            (root.blinking ?
                "      .--------.\n   __/  </>   \\__\n  /__ HARD HAT __\\\n     .-^^^^-.\n   _/  -  -  \\_\n  /    \\__/    \\   _\n |   .-<__>-.    |--<_|\n  \\__\\_VV_/___/\n     /_/  \\_\\" :
             root.gesture ?
                "      .--------.\n   __/  </>   \\__\n  /__ HARD HAT __\\\n     .-^^^^-.       /|\n   _/  >  <  \\_    ||\n  /    \\__/    \\___||\n |    .<__>.      ___/\n  \\___\\VV/____/\n      /_  _\\" :
                "      .--------.\n   __/  </>   \\__\n  /__ HARD HAT __\\\n     .-^^^^-.\n   _/  >  <  \\_\n  /    \\__/    \\   _\n |   .-<__>-.    |--<_|\n  \\__\\_VV_/___/\n     /_/  \\_\\") :
            root.accessory == "glasses" ?
            (root.blinking ?
                "       .-^^^^-.\n     _/  ----  \\_\n    /  [====]   \\   ___\n   |---[====]----|--/__/\n   |      ^      | /__/\n    \\   \\__/   /\n     '._<__>_.'\n       /_||_\\" :
             root.gesture ?
                "       .-^^^^-.\n     _/  >  <   \\_\n    /  [====]   \\  _/\n   |---[====]----|-(_ \n   |      ^      |  \\_\n    \\   \\__/   /\n     '._<__>_.'\n       /_||_\\" :
                "       .-^^^^-.\n     _/  o  o   \\_\n    /  [====]   \\   ___\n   |---[====]----|--/__/\n   |      ^      | /__/\n    \\   \\__/   /\n     '._<__>_.'\n       /_||_\\") :
            root.accessory == "wrench" ?
            (root.blinking ?
                "       .-^^^^-.\n     _/  -  -   \\_\n    /     __     \\      __\n   |    _/  \\_    |   __/  \\__\n   |   <  VV  >   |=={  WRENCH }\n    \\   \\__/   /   '--\\__/--'\n     '._<__>_.'\n       /_||_\\" :
             root.gesture ?
                "       .-^^^^-.       __\n     _/  >  <   \\_   __/  \\__\n    /    \\__/    \\={  WRENCH }\n   |    _/VV\\_    | '--\\__/--'\n   |   <______.>   |\n    \\            /\n     '._<__>_.'\n       /_||_\\" :
                "       .-^^^^-.\n     _/  >  <   \\_\n    /    \\__/    \\      __\n   |    _/VV\\_    |   __/  \\__\n   |   <______.>   |=={  WRENCH }\n    \\            /   '--\\__/--'\n     '._<__>_.'\n       /_||_\\") :
            (root.blinking ?
                "       .-^^^^-.\n     _/  -  -   \\_\n    /     __     \\       /\n   |    _/  \\_    |     /  \\==\n   |   <  VV  >   |----< PENCIL\n    \\   \\__/   /      \\  /==\n     '._<__>_.'        \\/\n       /_||_\\" :
             root.gesture ?
                "       .-^^^^-.          /\n     _/  >  <   \\_        /  \\==\n    /    \\__/    \\_____< PENCIL\n   |    _/VV\\_     _____/ \\  /==\n   |   <______.>   |        \\/\n    \\            /\n     '._<__>_.'\n       /_||_\\" :
                "       .-^^^^-.\n     _/  >  <   \\_\n    /    \\__/    \\       /\n   |    _/VV\\_    |      /  \\==\n   |   <______.>   |----< PENCIL\n    \\            /      \\  /==\n     '._<__>_.'        \\/\n       /_||_\\");
        color: root.focused ? root.blob-color : BlobTheme.text-muted;
        font-family: "Menlo";
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate y { duration: 120ms; }
    }

    Text {
        x: 12px;
        y: 198px;
        width: 200px;
        height: 20px;
        text: root.name + " [" + root.role + "]";
        color: root.focused ? BlobTheme.accent : BlobTheme.text-muted;
        font-size: 11px;
        font-weight: root.focused ? 600 : 400;
        horizontal-alignment: center;
    }
    Text {
        x: 12px;
        y: 219px;
        width: 200px;
        height: 16px;
        text: root.status;
        color: BlobTheme.text-faint;
        font-size: 8px;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
