import { BlobTheme } from "../design/tokens.slint";

export component SurfaceTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> body: "";
    in property <string> footer: "";
    in property <color> accent: BlobTheme.accent;
    in property <bool> active: false;
    callback activated;

    min-width: 220px;
    min-height: 150px;
    background: tile-touch.has-hover ? BlobTheme.surface-raised : BlobTheme.surface;
    border-color: root.active ? root.accent : BlobTheme.border;
    border-width: 1px;
    border-radius: BlobTheme.radius-lg;
    animate background, border-color { duration: 120ms; }

    // A restrained role marker instead of a bright dashboard-style stripe.
    Rectangle {
        x: 0px;
        y: 12px;
        width: 2px;
        height: parent.height - 24px;
        border-radius: 1px;
        background: root.accent;
    }

    VerticalLayout {
        padding: BlobTheme.space-5;
        padding-left: BlobTheme.space-6;
        spacing: BlobTheme.space-3;

        HorizontalLayout {
            spacing: BlobTheme.space-3;
            Text {
                text: root.title;
                color: BlobTheme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.subtitle;
                color: root.active ? root.accent : BlobTheme.text-faint;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.body;
            color: BlobTheme.text-muted;
            font-size: 12px;
            font-weight: 400;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.footer != "": Text {
            text: root.footer;
            color: BlobTheme.text-faint;
            font-size: 10px;
            wrap: word-wrap;
        }
    }

    tile-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
