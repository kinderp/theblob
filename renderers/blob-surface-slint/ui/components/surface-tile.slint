import { BlobTheme } from "../design/tokens.slint";

export component SurfaceTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> body: "";
    in property <string> gutter: "";
    in property <string> footer: "";
    in property <color> accent: BlobTheme.accent;
    in property <bool> active: false;
    callback activated;

    min-width: 220px;
    min-height: 150px;
    background: tile-touch.has-hover ? BlobTheme.surface-raised : BlobTheme.surface;
    border-color: root.active ? root.accent : BlobTheme.border;
    border-width: 1px;
    border-radius: 2px;
    animate background, border-color { duration: 100ms; }

    // Terminal/editor pane chrome, deliberately separate from Surface semantics.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 27px;
        background: #080b0e;
        border-color: BlobTheme.border-soft;
        border-width: 1px;

        HorizontalLayout {
            padding-left: BlobTheme.space-3;
            padding-right: BlobTheme.space-3;
            spacing: BlobTheme.space-2;

            Text {
                text: root.title;
                color: root.active ? root.accent : root.accent;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.subtitle;
                color: BlobTheme.text-faint;
                font-size: 9px;
                vertical-alignment: center;
            }
            Text {
                text: "⋮";
                color: BlobTheme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 27px;
        width: 2px;
        height: parent.height - 27px;
        background: root.accent;
    }

    VerticalLayout {
        padding-top: 38px;
        padding-bottom: BlobTheme.space-3;
        padding-left: BlobTheme.space-3;
        padding-right: BlobTheme.space-3;
        spacing: BlobTheme.space-2;

        HorizontalLayout {
            spacing: BlobTheme.space-3;
            vertical-stretch: 1;

            if root.gutter != "": Text {
                width: 38px;
                text: root.gutter;
                color: #4f5963;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: top;
            }

            if root.gutter != "": Rectangle {
                width: 1px;
                background: BlobTheme.border-soft;
            }

            Text {
                horizontal-stretch: 1;
                text: root.body;
                color: BlobTheme.text-muted;
                font-size: 10px;
                font-weight: 400;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        if root.footer != "": Text {
            text: root.footer;
            color: BlobTheme.text-faint;
            font-size: 8px;
            wrap: word-wrap;
        }
    }

    tile-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
