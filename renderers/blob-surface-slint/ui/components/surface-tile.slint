import { BlobTheme } from "../design/tokens.slint";

export component SurfaceTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> body: "";
    in property <string> footer: "";
    in property <color> accent: BlobTheme.accent;
    in property <bool> active: false;
    callback activated;

    min-width: 220px;
    min-height: 150px;
    background: tile-touch.has-hover ? BlobTheme.surface-raised : BlobTheme.surface;
    border-color: root.active ? root.accent : BlobTheme.border;
    border-width: 1px;
    border-radius: 2px;
    animate background, border-color { duration: 100ms; }

    // Terminal-pane header rather than application-card chrome.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 27px;
        background: #080b0e;
        border-color: BlobTheme.border-soft;
        border-width: 1px;

        HorizontalLayout {
            padding-left: BlobTheme.space-3;
            padding-right: BlobTheme.space-3;
            spacing: BlobTheme.space-2;

            Text {
                text: ":: " + root.title;
                color: root.active ? root.accent : BlobTheme.text;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.subtitle == "" ? "" : "[" + root.subtitle + "]";
                color: BlobTheme.text-faint;
                font-size: 9px;
                vertical-alignment: center;
            }
        }
    }

    // Thin semantic marker; colour behaves like syntax highlighting.
    Rectangle {
        x: 0px;
        y: 27px;
        width: 2px;
        height: parent.height - 27px;
        background: root.accent;
    }

    VerticalLayout {
        padding-top: 39px;
        padding-bottom: BlobTheme.space-3;
        padding-left: BlobTheme.space-4;
        padding-right: BlobTheme.space-4;
        spacing: BlobTheme.space-3;

        Text {
            text: root.body;
            color: BlobTheme.text-muted;
            font-size: 11px;
            font-weight: 400;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.footer != "": Text {
            text: "↳ " + root.footer;
            color: BlobTheme.text-faint;
            font-size: 9px;
            wrap: word-wrap;
        }
    }

    tile-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
