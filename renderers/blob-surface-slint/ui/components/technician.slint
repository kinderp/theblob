import { BlobTheme } from "../design/tokens.slint";
import { BlobAction, BlobStatus } from "primitives.slint";

export component TechnicianPanel inherits Rectangle {
    in property <string> context-summary;
    in property <string> verifier-summary;
    in property <string> response-title;
    in property <string> response-body;
    in property <string> response-detail;
    in property <string> intent-status;
    callback explain;
    callback teach;
    callback prepare;
    callback close;

    width: BlobTheme.technician-width;
    background: BlobTheme.surface;
    border-color: BlobTheme.border-soft;
    border-width: 1px;

    VerticalLayout {
        padding: BlobTheme.space-5;
        spacing: BlobTheme.space-5;

        HorizontalLayout {
            spacing: BlobTheme.space-3;
            VerticalLayout {
                spacing: BlobTheme.space-2;
                Text {
                    text: "TECHNICIAN";
                    color: BlobTheme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "Evidence-backed · no hidden authority";
                    color: BlobTheme.text-faint;
                    font-size: 11px;
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: close-area.has-hover ? BlobTheme.surface-raised : transparent;
                Text {
                    text: "−";
                    color: BlobTheme.text-muted;
                    font-size: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }
        }

        BlobStatus { label: "Everything is calm"; positive: true; }

        Text {
            text: root.context-summary;
            color: BlobTheme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            background: BlobTheme.surface-soft;
            border-color: BlobTheme.border-soft;
            border-width: 1px;
            border-radius: BlobTheme.radius-lg;
            min-height: 230px;

            VerticalLayout {
                padding: BlobTheme.space-4;
                spacing: BlobTheme.space-3;

                Text {
                    text: root.response-title;
                    color: BlobTheme.text;
                    font-size: 16px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: root.response-body;
                    color: BlobTheme.text-muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    text: root.response-detail;
                    color: BlobTheme.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            text: root.intent-status;
            color: BlobTheme.warning;
            font-size: 11px;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: BlobTheme.space-2;
            BlobAction {
                label: "Explain what happened";
                clicked => { root.explain(); }
            }
            BlobAction {
                label: "Teach me";
                clicked => { root.teach(); }
            }
            BlobAction {
                label: "Prepare next step";
                primary: true;
                clicked => { root.prepare(); }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Text {
            text: root.verifier-summary;
            color: BlobTheme.text-faint;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}
