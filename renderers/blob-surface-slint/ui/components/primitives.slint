import { BlobTheme } from "../design/tokens.slint";

export component BlobCard inherits Rectangle {
    in property <string> panel-id: "";
    in property <string> eyebrow: "";
    in property <string> title: "";
    in property <string> body: "";
    in property <string> meta: "";

    background: BlobTheme.surface;
    border-color: BlobTheme.border-soft;
    border-width: 1px;
    border-radius: BlobTheme.radius-lg;

    VerticalLayout {
        padding: BlobTheme.space-5;
        spacing: BlobTheme.space-3;

        Text {
            text: root.eyebrow;
            color: BlobTheme.text-faint;
            font-size: BlobTheme.font-body;
            font-weight: 700;
        }

        Text {
            text: root.title;
            color: BlobTheme.text;
            font-size: 22px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.body;
            color: BlobTheme.text-muted;
            font-size: BlobTheme.font-title;
            wrap: word-wrap;
        }

        Text {
            text: root.meta;
            color: BlobTheme.text-faint;
            font-size: BlobTheme.font-label;
            wrap: word-wrap;
        }
    }
}

export component BlobNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;

    height: 44px;
    border-radius: BlobTheme.radius-md;
    background: selected ? BlobTheme.accent-soft : nav-area.has-hover ? BlobTheme.surface-raised : transparent;

    Text {
        x: BlobTheme.space-4;
        vertical-alignment: center;
        text: root.label;
        color: selected ? BlobTheme.accent : BlobTheme.text-muted;
        font-size: BlobTheme.font-title;
        font-weight: selected ? 700 : 500;
    }

    nav-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BlobStatus inherits Rectangle {
    in property <string> label;
    in property <bool> positive: false;

    min-width: 90px;
    height: 32px;
    border-radius: 16px;
    background: positive ? BlobTheme.success-soft : BlobTheme.surface-raised;
    border-color: positive ? #cbe9d4 : BlobTheme.border-soft;
    border-width: 1px;

    Text {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: positive ? BlobTheme.success : BlobTheme.text-muted;
        font-size: BlobTheme.font-label;
        font-weight: 600;
    }
}

export component BlobAction inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;

    height: 42px;
    border-radius: BlobTheme.radius-md;
    background: root.primary
        ? (action-area.has-hover ? #5849db : BlobTheme.accent)
        : (action-area.has-hover ? BlobTheme.accent-soft : BlobTheme.surface-raised);
    border-color: root.primary ? BlobTheme.accent : BlobTheme.border;
    border-width: 1px;

    Text {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: root.primary ? #ffffff : BlobTheme.text;
        font-size: BlobTheme.font-label;
        font-weight: 600;
    }

    action-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
