import { BlobTheme } from "../design/tokens.slint";

// Low-level terminal-like editor used by both Blobsh bars. Text and the native
// blinking caret share the same vertically centered TextInput. The wrapper clips
// overflow and follows the caret horizontally so long expert commands remain
// editable on small screens.
component BlobshLineEditor inherits Rectangle {
    in-out property <string> text: "";
    in property <brush> text-color: BlobTheme.text;
    callback accepted;
    callback edited;

    private property <length> caret-margin: 8px;
    forward-focus: editor;
    background: transparent;
    clip: true;

    editor := TextInput {
        x: 0px;
        y: 0px;
        height: parent.height;
        width: max(parent.width, self.preferred-width + 4px);
        text <=> root.text;
        color: root.text-color;
        selection-background-color: BlobTheme.accent-soft;
        font-size: 11px;
        font-family: "Menlo";
        vertical-alignment: center;
        text-cursor-width: 2px;
        single-line: true;

        cursor-position-changed(position) => {
            if (position.x + self.x < root.caret-margin) {
                self.x = -position.x + root.caret-margin;
            } else if (position.x + self.x > parent.width - root.caret-margin - self.text-cursor-width) {
                self.x = parent.width - position.x - root.caret-margin - self.text-cursor-width;
            } else if (self.preferred-width <= parent.width) {
                self.x = 0px;
            }
        }
        edited => {
            if (self.preferred-width <= parent.width) { self.x = 0px; }
            root.edited();
        }
        accepted => { root.accepted(); }
    }
}

export component BlobshBars inherits Rectangle {
    in-out property <string> prompt-text: "";
    in property <string> prompt-status: "ask The Blob";
    in-out property <string> command-text: "";
    in property <string> command-level: "2/6 INTENT";
    in property <string> command-status: "preview";
    in-out property <bool> ai-collapsed: false;
    in-out property <bool> command-collapsed: false;

    in-out property <bool> copilot-open: false;
    in property <string> copilot-title: "Command Copilot";
    in property <string> copilot-body: "Edit the BLOB command directly or ask the AI for help.";
    in property <string> copilot-source: "Blobsh schema";
    in property <string> completion-1: "";
    in property <string> completion-2: "";
    in property <string> completion-3: "";

    callback submit-prompt(string);
    callback submit-command(string);
    callback command-edited(string);
    callback completion-selected(string);
    callback ask-ai-about-command(string);
    callback command-shallower;
    callback command-deeper;

    private property <string> inferred-title: root.command-level == "1/6 USER" ? "USER · original request"
        : root.command-level == "2/6 INTENT" ? "INTENT · canonical Blob command"
        : root.command-level == "3/6 PLAN" ? "PLAN · resolved execution intent"
        : root.command-level == "4/6 SPEC" ? "SPEC · semantic desired state"
        : root.command-level == "5/6 BACKEND" ? "BACKEND · platform materialization"
        : "NATIVE · concrete machine operation";
    private property <string> inferred-body: root.command-level == "1/6 USER" ? "What you asked for. Edit here to reinterpret the request and regenerate deeper levels."
        : root.command-level == "2/6 INTENT" ? "The precise command The Blob understood. This is the safest expert editing point in P0."
        : root.command-level == "3/6 PLAN" ? "Capability, placement and authority choices derived from the intent."
        : root.command-level == "4/6 SPEC" ? "Semantic state change. For Bluetooth the demo deliberately stops here until a real backend materializes more."
        : root.command-level == "5/6 BACKEND" ? "Platform-specific representation produced by a deterministic adapter. Never fabricated by the UI."
        : "Lowest concrete operation available: shell, D-Bus, API, filesystem transaction, RPC or another native mechanism.";
    private property <string> inferred-source: root.command-level == "2/6 INTENT" ? "Blobsh command schema · docs/BLOBSH-v0.1.md"
        : root.command-level == "4/6 SPEC" ? "SystemSpec / semantic proposal"
        : "Blobsh trace contract · docs/BLOBSH-v0.1.md";

    // P0 completion is intentionally conservative: only commands the current
    // deterministic demo actually understands are offered. Platform/backend
    // flags arrive only when their real parser/materializer exists.
    private property <string> fallback-completion-1: root.command-level != "2/6 INTENT" ? ""
        : root.command-text == "workspace.open romeo" ? "workspace.open docs"
        : root.command-text == "workspace.open docs" ? "workspace.open system"
        : root.command-text == "workspace.open system" ? "workspace.open notes"
        : "system.bluetooth enable";
    private property <string> fallback-completion-2: root.command-level != "2/6 INTENT" ? ""
        : root.command-text == "workspace.open romeo" ? "workspace.open system"
        : root.command-text == "workspace.open docs" ? "workspace.open notes"
        : root.command-text == "system.bluetooth enable" ? "workspace.open system"
        : "technician.explain current";
    private property <string> fallback-completion-3: root.command-level != "2/6 INTENT" ? ""
        : root.command-text == "workspace.open romeo" ? "workspace.open notes"
        : root.command-text == "system.bluetooth enable" ? "technician.explain current"
        : "workspace.collapse all";

    private property <string> shown-title: root.copilot-title == "Command Copilot" ? root.inferred-title : root.copilot-title;
    private property <string> shown-body: root.copilot-body == "Edit the BLOB command directly or ask the AI for help." ? root.inferred-body : root.copilot-body;
    private property <string> shown-source: root.copilot-source == "Blobsh schema" ? root.inferred-source : root.copilot-source;
    private property <string> shown-completion-1: root.completion-1 == "" ? root.fallback-completion-1 : root.completion-1;
    private property <string> shown-completion-2: root.completion-2 == "" ? root.fallback-completion-2 : root.completion-2;
    private property <string> shown-completion-3: root.completion-3 == "" ? root.fallback-completion-3 : root.completion-3;

    forward-focus: ai-input;
    init => { ai-input.focus(); }

    height: (root.ai-collapsed ? 25px : 42px)
        + (root.command-collapsed ? 25px : 42px)
        + (root.copilot-open ? 78px : 0px);
    background: #070a0d;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: root.ai-collapsed ? 25px : 42px;
            background: #070a0d;
            border-color: BlobTheme.border-soft;
            border-width: 1px;

            HorizontalLayout {
                padding-left: BlobTheme.space-3;
                padding-right: BlobTheme.space-3;
                spacing: BlobTheme.space-2;

                Text {
                    text: "λ AI";
                    color: BlobTheme.accent;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                ai-input := BlobshLineEditor {
                    visible: !root.ai-collapsed;
                    horizontal-stretch: 1;
                    text <=> root.prompt-text;
                    text-color: BlobTheme.text;
                    accepted => { root.submit-prompt(root.prompt-text); }
                }

                Text {
                    visible: root.ai-collapsed;
                    horizontal-stretch: 1;
                    text: root.prompt-status;
                    color: BlobTheme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.ai-collapsed ? "[+]" : "[-]";
                    color: ai-collapse.has-hover ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                    ai-collapse := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.ai-collapsed = !root.ai-collapsed;
                            if (!root.ai-collapsed) { ai-input.focus(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: root.command-collapsed ? 25px : 42px;
            background: #090d11;
            border-color: BlobTheme.border;
            border-width: 1px;

            HorizontalLayout {
                padding-left: BlobTheme.space-3;
                padding-right: BlobTheme.space-3;
                spacing: BlobTheme.space-2;

                Text {
                    text: "> BLOB";
                    color: BlobTheme.accent-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Text {
                    text: "[↑]";
                    color: shallower.has-hover ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                    shallower := TouchArea { mouse-cursor: pointer; clicked => { root.command-shallower(); } }
                }
                Text {
                    text: root.command-level;
                    color: BlobTheme.text-muted;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                Text {
                    text: "[↓]";
                    color: deeper.has-hover ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                    deeper := TouchArea { mouse-cursor: pointer; clicked => { root.command-deeper(); } }
                }

                command-input := BlobshLineEditor {
                    visible: !root.command-collapsed;
                    horizontal-stretch: 1;
                    text <=> root.command-text;
                    text-color: BlobTheme.text;
                    edited => {
                        root.command-edited(root.command-text);
                        root.copilot-open = true;
                    }
                    accepted => { root.submit-command(root.command-text); }
                }

                Text {
                    visible: root.command-collapsed;
                    horizontal-stretch: 1;
                    text: root.command-text == "" ? "no command" : root.command-text;
                    color: BlobTheme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: "[?]";
                    color: copilot-touch.has-hover || root.copilot-open ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                    copilot-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copilot-open = !root.copilot-open; }
                    }
                }
                Text {
                    text: "[" + root.command-status + "]";
                    color: root.command-status == "approval required" ? BlobTheme.warning : BlobTheme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.command-collapsed ? "[+]" : "[-]";
                    color: command-collapse.has-hover ? BlobTheme.accent : BlobTheme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                    command-collapse := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.command-collapsed = !root.command-collapsed;
                            if (!root.command-collapsed) { command-input.focus(); }
                        }
                    }
                }
            }
        }

        if root.copilot-open: Rectangle {
            height: 78px;
            background: #080c10;
            border-color: BlobTheme.border-soft;
            border-width: 1px;

            HorizontalLayout {
                padding-left: BlobTheme.space-3;
                padding-right: BlobTheme.space-3;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: BlobTheme.space-4;

                VerticalLayout {
                    horizontal-stretch: 3;
                    spacing: 3px;
                    Text { text: root.shown-title; color: BlobTheme.accent; font-size: 9px; font-weight: 600; }
                    Text { text: root.shown-body; color: BlobTheme.text-muted; font-size: 8px; wrap: word-wrap; }
                    Text { text: "source: " + root.shown-source; color: BlobTheme.text-faint; font-size: 7px; }
                }

                VerticalLayout {
                    horizontal-stretch: 2;
                    spacing: 2px;
                    Text { text: root.command-level == "2/6 INTENT" ? "COMPLETION · valid P0 commands" : "COMPLETION · none at this materialized level"; color: BlobTheme.text-faint; font-size: 7px; }
                    if root.shown-completion-1 != "": Text { text: "> " + root.shown-completion-1; color: completion-touch-1.has-hover ? BlobTheme.accent : BlobTheme.text; font-size: 8px; completion-touch-1 := TouchArea { mouse-cursor: pointer; clicked => { root.command-text = root.shown-completion-1; root.command-edited(root.command-text); root.completion-selected(root.command-text); command-input.focus(); } } }
                    if root.shown-completion-2 != "": Text { text: "> " + root.shown-completion-2; color: completion-touch-2.has-hover ? BlobTheme.accent : BlobTheme.text-muted; font-size: 8px; completion-touch-2 := TouchArea { mouse-cursor: pointer; clicked => { root.command-text = root.shown-completion-2; root.command-edited(root.command-text); root.completion-selected(root.command-text); command-input.focus(); } } }
                    if root.shown-completion-3 != "": Text { text: "> " + root.shown-completion-3; color: completion-touch-3.has-hover ? BlobTheme.accent : BlobTheme.text-muted; font-size: 8px; completion-touch-3 := TouchArea { mouse-cursor: pointer; clicked => { root.command-text = root.shown-completion-3; root.command-edited(root.command-text); root.completion-selected(root.command-text); command-input.focus(); } } }
                    Text {
                        text: "[ask AI about this " + root.command-level + "]";
                        color: ask-ai-touch.has-hover ? BlobTheme.accent-secondary : BlobTheme.text-faint;
                        font-size: 8px;
                        ask-ai-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.prompt-text = "Aiutami a capire o modificare " + root.command-level + ": " + root.command-text;
                                root.ask-ai-about-command(root.command-text);
                                ai-input.focus();
                            }
                        }
                    }
                }
            }
        }
    }
}
