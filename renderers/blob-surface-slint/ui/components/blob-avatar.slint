import { BlobTheme } from "../design/tokens.slint";

export component BlobAvatar inherits Rectangle {
    in property <string> name;
    in property <string> role;
    in property <string> status;
    in property <string> accessory;
    in property <color> blob-color;
    in property <bool> focused: false;
    callback activated;

    property <bool> idle-up: false;
    property <bool> sway-left: false;
    property <bool> blinking: false;
    property <bool> gesture: false;

    width: 224px;
    height: 250px;
    background: transparent;

    // Slow breathing + sway. The timers only change a few vector properties;
    // there is no continuously rendered 3D scene.
    Timer {
        interval: root.accessory == "helmet" ? 5000ms : root.accessory == "glasses" ? 5700ms : root.accessory == "wrench" ? 5300ms : 6100ms;
        running: true;
        triggered() => {
            root.idle-up = !root.idle-up;
            root.sway-left = !root.sway-left;
        }
    }

    // A short autonomous blink makes the characters feel present even when the
    // pointer is elsewhere. Different periods keep the four Blobs out of sync.
    Timer {
        interval: root.accessory == "helmet" ? 3900ms : root.accessory == "glasses" ? 4700ms : root.accessory == "wrench" ? 4300ms : 5200ms;
        running: true;
        triggered() => { root.blinking = true; }
    }
    Timer {
        interval: 135ms;
        running: root.blinking;
        triggered() => { root.blinking = false; }
    }

    // Rare little gesture: mainly a hand lift and expression change. This is
    // intentionally infrequent so the home screen is alive without being busy.
    Timer {
        interval: root.accessory == "helmet" ? 8200ms : root.accessory == "glasses" ? 9400ms : root.accessory == "wrench" ? 8800ms : 10100ms;
        running: true;
        triggered() => { root.gesture = true; }
    }
    Timer {
        interval: 620ms;
        running: root.gesture;
        triggered() => { root.gesture = false; }
    }

    halo := Rectangle {
        x: touch.has-hover ? 13px : 20px;
        y: touch.has-hover ? 7px : 16px;
        width: touch.has-hover ? 198px : 184px;
        height: touch.has-hover ? 198px : 184px;
        border-radius: 99px;
        background: touch.has-hover ? BlobTheme.glow-soft : transparent;
        border-color: root.focused ? root.blob-color : transparent;
        border-width: root.focused ? 1px : 0px;
        animate x, y, width, height, background, border-color { duration: 180ms; easing: ease-out; }
    }

    character := Rectangle {
        x: touch.has-hover ? 4px : (root.sway-left ? 2px : 6px);
        y: touch.has-hover ? -2px : (root.idle-up ? 7px : 12px);
        width: 216px;
        height: 200px;
        background: transparent;
        animate x, y { duration: touch.has-hover ? 170ms : 650ms; easing: ease-in-out; }

        // Ground shadow separates the character from the flat Shell surface and
        // breathes very slightly with the body.
        Rectangle {
            x: touch.has-hover ? 64px : (root.idle-up ? 58px : 55px);
            y: 183px;
            width: touch.has-hover ? 90px : (root.idle-up ? 102px : 108px);
            height: touch.has-hover ? 8px : (root.idle-up ? 11px : 13px);
            border-radius: 7px;
            background: #00000052;
            animate x, width, height { duration: touch.has-hover ? 170ms : 650ms; easing: ease-in-out; }
        }

        // Rear depth masses: cheap vector layers that create a soft 3D rim.
        Rectangle {
            x: touch.has-hover ? 29px : 36px;
            y: touch.has-hover ? 60px : 55px;
            width: touch.has-hover ? 173px : 158px;
            height: touch.has-hover ? 118px : 126px;
            border-radius: 63px;
            background: #00000038;
            animate x, y, width, height { duration: 180ms; easing: ease-out; }
        }
        Rectangle {
            x: touch.has-hover ? 149px : 143px;
            y: touch.has-hover ? 90px : 86px;
            width: 58px;
            height: 72px;
            border-radius: 29px;
            background: #0000002c;
            animate x, y { duration: 180ms; }
        }

        // Arms. Hover is an explicit hello; autonomous gesture is a smaller wave.
        Rectangle {
            x: 11px;
            y: touch.has-hover ? 95px : (root.gesture ? 91px : 103px);
            width: 48px;
            height: 40px;
            border-radius: 20px;
            background: root.blob-color;
            animate y { duration: 180ms; easing: ease-out; }
        }
        Rectangle {
            x: 160px;
            y: touch.has-hover ? 61px : (root.gesture ? 72px : 101px);
            width: 48px;
            height: 40px;
            border-radius: 20px;
            background: root.blob-color;
            animate y { duration: 220ms; easing: ease-out; }
        }

        // Main organic mass: slow breathing in idle, stronger squash on hover.
        body := Rectangle {
            x: touch.has-hover ? 23px : (root.idle-up ? 28px : 30px);
            y: touch.has-hover ? 52px : (root.idle-up ? 49px : 47px);
            width: touch.has-hover ? 172px : (root.idle-up ? 162px : 158px);
            height: touch.has-hover ? 118px : (root.idle-up ? 123px : 128px);
            border-radius: 63px;
            background: root.blob-color;
            animate x, y, width, height { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }
        Rectangle {
            x: touch.has-hover ? 18px : 23px;
            y: touch.has-hover ? 86px : (root.idle-up ? 84px : 82px);
            width: 58px;
            height: 70px;
            border-radius: 29px;
            background: root.blob-color;
            animate x, y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }
        Rectangle {
            x: touch.has-hover ? 145px : 139px;
            y: touch.has-hover ? 83px : (root.idle-up ? 80px : 78px);
            width: 59px;
            height: 73px;
            border-radius: 30px;
            background: root.blob-color;
            animate x, y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }
        Rectangle {
            x: 47px;
            y: touch.has-hover ? 35px : (root.idle-up ? 32px : 30px);
            width: 63px;
            height: 66px;
            border-radius: 32px;
            background: root.blob-color;
            animate y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }
        Rectangle {
            x: 101px;
            y: touch.has-hover ? 39px : (root.idle-up ? 36px : 34px);
            width: 66px;
            height: 62px;
            border-radius: 31px;
            background: root.blob-color;
            animate y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }

        // Lightweight pseudo-3D lighting. Highlights drift with breathing so the
        // volume reads as soft material rather than a flat sticker.
        Rectangle {
            x: touch.has-hover ? 43px : (root.sway-left ? 47px : 51px);
            y: touch.has-hover ? 58px : (root.idle-up ? 55px : 53px);
            width: touch.has-hover ? 76px : 68px;
            height: 31px;
            border-radius: 16px;
            background: #ffffff28;
            animate x, y, width { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }
        Rectangle {
            x: touch.has-hover ? 49px : (root.sway-left ? 53px : 57px);
            y: touch.has-hover ? 63px : (root.idle-up ? 60px : 58px);
            width: 36px;
            height: 13px;
            border-radius: 7px;
            background: #ffffff42;
            animate x, y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; }
        }
        Rectangle {
            x: touch.has-hover ? 136px : 129px;
            y: touch.has-hover ? 126px : 129px;
            width: 48px;
            height: 28px;
            border-radius: 14px;
            background: #00000018;
            animate x, y { duration: 180ms; }
        }

        // Three soft feet bounce with the body.
        Rectangle { x: 49px; y: touch.has-hover ? 148px : (root.idle-up ? 149px : 152px); width: 43px; height: 44px; border-radius: 22px; background: root.blob-color; animate y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; } }
        Rectangle { x: 88px; y: touch.has-hover ? 153px : (root.idle-up ? 154px : 158px); width: 42px; height: 39px; border-radius: 21px; background: root.blob-color; animate y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; } }
        Rectangle { x: 126px; y: touch.has-hover ? 148px : (root.idle-up ? 149px : 152px); width: 43px; height: 44px; border-radius: 22px; background: root.blob-color; animate y { duration: touch.has-hover ? 180ms : 650ms; easing: ease-in-out; } }

        // Eyes blink autonomously and acknowledge hover with a wider expression.
        left-eye := Rectangle {
            x: touch.has-hover ? 65px : 68px;
            y: root.blinking ? 104px : (touch.has-hover ? 88px : 91px);
            width: touch.has-hover ? 30px : 27px;
            height: root.blinking ? 4px : (touch.has-hover ? 34px : 29px);
            border-radius: 15px;
            background: BlobTheme.eye;
            clip: true;
            animate x, y, width, height { duration: root.blinking ? 70ms : 150ms; }
            Rectangle {
                x: touch.has-hover ? 12px : 8px;
                y: touch.has-hover ? 11px : 10px;
                width: 9px;
                height: root.blinking ? 0px : 12px;
                border-radius: 5px;
                background: BlobTheme.ink;
                animate x, y, height { duration: 100ms; }
            }
            Rectangle { x: 17px; y: 7px; width: 4px; height: root.blinking ? 0px : 4px; border-radius: 2px; background: #ffffff; }
        }
        right-eye := Rectangle {
            x: 124px;
            y: root.blinking ? 104px : (touch.has-hover ? 88px : 91px);
            width: touch.has-hover ? 30px : 27px;
            height: root.blinking ? 4px : (touch.has-hover ? 34px : 29px);
            border-radius: 15px;
            background: BlobTheme.eye;
            clip: true;
            animate y, width, height { duration: root.blinking ? 70ms : 150ms; }
            Rectangle {
                x: touch.has-hover ? 9px : 10px;
                y: touch.has-hover ? 11px : 10px;
                width: 9px;
                height: root.blinking ? 0px : 12px;
                border-radius: 5px;
                background: BlobTheme.ink;
                animate x, y, height { duration: 100ms; }
            }
            Rectangle { x: 14px; y: 7px; width: 4px; height: root.blinking ? 0px : 4px; border-radius: 2px; background: #ffffff; }
        }

        Rectangle { x: 50px; y: 126px; width: touch.has-hover || root.gesture ? 20px : 17px; height: 8px; border-radius: 4px; background: BlobTheme.cheek; animate width { duration: 150ms; } }
        Rectangle { x: 149px; y: 126px; width: touch.has-hover || root.gesture ? 20px : 17px; height: 8px; border-radius: 4px; background: BlobTheme.cheek; animate width { duration: 150ms; } }

        Text {
            x: touch.has-hover ? 88px : 91px;
            y: touch.has-hover ? 119px : 120px;
            width: touch.has-hover ? 44px : 38px;
            height: 29px;
            text: touch.has-hover || root.gesture ? "⌣" : "◡";
            color: BlobTheme.ink;
            font-size: touch.has-hover || root.gesture ? 28px : 23px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate x, width, font-size { duration: 150ms; }
        }

        if root.accessory == "helmet": Rectangle {
            x: 55px;
            y: touch.has-hover ? 21px : (root.gesture ? 16px : 18px);
            width: 110px;
            height: 39px;
            border-radius: 20px;
            background: BlobTheme.helmet;
            animate y { duration: 180ms; }
            Rectangle { x: 46px; y: -7px; width: 18px; height: 46px; border-radius: 7px; background: BlobTheme.helmet-dark; }
            Rectangle { x: -9px; y: 31px; width: 128px; height: 11px; border-radius: 6px; background: BlobTheme.helmet-dark; }
            Rectangle { x: 13px; y: 5px; width: 43px; height: 9px; border-radius: 5px; background: #ffffff30; }
        }

        if root.accessory == "glasses": Rectangle {
            x: touch.has-hover ? 54px : 55px;
            y: root.blinking ? 89px : (touch.has-hover ? 87px : 88px);
            width: 53px;
            height: 38px;
            border-radius: 15px;
            background: #202124dd;
            border-color: BlobTheme.docs;
            border-width: 3px;
            animate y { duration: 120ms; }
            Rectangle {
                x: 57px;
                y: 0px;
                width: 53px;
                height: 38px;
                border-radius: 15px;
                background: #202124dd;
                border-color: BlobTheme.docs;
                border-width: 3px;
            }
            Rectangle { x: 48px; y: 16px; width: 12px; height: 4px; background: BlobTheme.docs; }
            Rectangle { x: 8px; y: 6px; width: 16px; height: 5px; border-radius: 3px; background: #ffffff2d; }
            Rectangle { x: 65px; y: 6px; width: 16px; height: 5px; border-radius: 3px; background: #ffffff2d; }
        }

        if root.accessory == "wrench": Text {
            x: 151px;
            y: touch.has-hover ? 20px : (root.gesture ? 18px : 27px);
            width: 48px;
            height: 57px;
            text: "⚙";
            color: BlobTheme.system;
            font-size: touch.has-hover || root.gesture ? 42px : 38px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate y, font-size { duration: 180ms; }
        }

        if root.accessory == "pencil": Text {
            x: 151px;
            y: touch.has-hover ? 20px : (root.gesture ? 18px : 27px);
            width: 50px;
            height: 58px;
            text: "✎";
            color: BlobTheme.notes;
            font-size: touch.has-hover || root.gesture ? 43px : 39px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate y, font-size { duration: 180ms; }
        }
    }

    Text {
        x: 14px;
        y: 209px;
        width: 196px;
        height: 22px;
        text: root.name;
        color: root.focused ? BlobTheme.text : BlobTheme.text-muted;
        font-size: 14px;
        font-weight: root.focused ? 600 : 500;
        horizontal-alignment: center;
    }

    Text {
        x: 14px;
        y: 231px;
        width: 196px;
        height: 18px;
        text: root.status == "" ? root.role : root.role + " · " + root.status;
        color: BlobTheme.text-faint;
        font-size: 10px;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
