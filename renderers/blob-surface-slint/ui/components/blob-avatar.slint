import { BlobTheme } from "../design/tokens.slint";

export component BlobAvatar inherits Rectangle {
    in property <string> name;
    in property <string> role;
    in property <string> status;
    in property <string> accessory;
    in property <color> blob-color;
    in property <bool> focused: false;
    callback activated;

    property <bool> idle-up: false;

    width: 224px;
    height: 246px;
    background: transparent;

    // Slow, deliberately non-continuous idle movement. Different roles use
    // slightly different periods so the Workspace characters do not march in
    // lockstep or turn the shell into an animated dashboard.
    Timer {
        interval: root.accessory == "helmet" ? 2700ms : root.accessory == "glasses" ? 3100ms : root.accessory == "wrench" ? 2900ms : 3300ms;
        running: true;
        triggered() => {
            root.idle-up = !root.idle-up;
        }
    }

    halo := Rectangle {
        x: 20px;
        y: 16px;
        width: 184px;
        height: 184px;
        border-radius: 92px;
        background: touch.has-hover ? BlobTheme.glow-soft : transparent;
        border-color: root.focused ? BlobTheme.border : transparent;
        border-width: root.focused ? 1px : 0px;
        animate background, border-color { duration: 160ms; }
    }

    character := Rectangle {
        x: 4px;
        y: touch.has-hover ? 3px : (root.idle-up ? 7px : 11px);
        width: 216px;
        height: 196px;
        background: transparent;
        animate y { duration: 900ms; easing: ease-in-out; }

        // Soft shadow anchors the character while keeping the silhouette light.
        Rectangle {
            x: 55px;
            y: 174px;
            width: 108px;
            height: 13px;
            border-radius: 7px;
            background: #00000038;
        }

        // Organic body: overlapping rounded masses instead of an icon/card.
        Rectangle {
            x: 30px;
            y: 47px;
            width: 158px;
            height: 126px;
            border-radius: 63px;
            background: root.blob-color;
        }
        Rectangle {
            x: 23px;
            y: 82px;
            width: 58px;
            height: 72px;
            border-radius: 29px;
            background: root.blob-color;
        }
        Rectangle {
            x: 139px;
            y: 78px;
            width: 59px;
            height: 76px;
            border-radius: 30px;
            background: root.blob-color;
        }
        Rectangle {
            x: 47px;
            y: 30px;
            width: 63px;
            height: 66px;
            border-radius: 32px;
            background: root.blob-color;
        }
        Rectangle {
            x: 101px;
            y: 34px;
            width: 66px;
            height: 62px;
            border-radius: 31px;
            background: root.blob-color;
        }

        // Three little feet make the Blob feel like a character rather than a logo.
        Rectangle { x: 49px; y: 145px; width: 43px; height: 44px; border-radius: 22px; background: root.blob-color; }
        Rectangle { x: 88px; y: 151px; width: 42px; height: 39px; border-radius: 21px; background: root.blob-color; }
        Rectangle { x: 126px; y: 145px; width: 43px; height: 44px; border-radius: 22px; background: root.blob-color; }

        // Friendly face. White eyes improve expression on muted Blob colours;
        // pupils react subtly to hover so the character acknowledges the user.
        left-eye := Rectangle {
            x: 68px;
            y: 91px;
            width: 27px;
            height: touch.has-hover ? 31px : 29px;
            border-radius: 14px;
            background: BlobTheme.eye;
            animate height { duration: 120ms; }
            Rectangle {
                x: touch.has-hover ? 10px : 8px;
                y: 10px;
                width: 9px;
                height: 12px;
                border-radius: 5px;
                background: BlobTheme.ink;
                animate x { duration: 120ms; }
            }
        }
        right-eye := Rectangle {
            x: 124px;
            y: 91px;
            width: 27px;
            height: touch.has-hover ? 31px : 29px;
            border-radius: 14px;
            background: BlobTheme.eye;
            animate height { duration: 120ms; }
            Rectangle {
                x: touch.has-hover ? 8px : 10px;
                y: 10px;
                width: 9px;
                height: 12px;
                border-radius: 5px;
                background: BlobTheme.ink;
                animate x { duration: 120ms; }
            }
        }

        Rectangle { x: 54px; y: 125px; width: 17px; height: 8px; border-radius: 4px; background: BlobTheme.cheek; }
        Rectangle { x: 148px; y: 125px; width: 17px; height: 8px; border-radius: 4px; background: BlobTheme.cheek; }

        Text {
            x: 91px;
            y: 118px;
            width: 38px;
            height: 27px;
            text: touch.has-hover ? "⌣" : "◡";
            color: BlobTheme.ink;
            font-size: touch.has-hover ? 25px : 23px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate font-size { duration: 120ms; }
        }

        if root.accessory == "helmet": Rectangle {
            x: 55px;
            y: 18px;
            width: 110px;
            height: 39px;
            border-radius: 20px;
            background: BlobTheme.helmet;
            Rectangle { x: 46px; y: -7px; width: 18px; height: 46px; border-radius: 7px; background: BlobTheme.helmet-dark; }
            Rectangle { x: -9px; y: 31px; width: 128px; height: 11px; border-radius: 6px; background: BlobTheme.helmet-dark; }
        }

        if root.accessory == "glasses": Rectangle {
            x: 55px;
            y: 88px;
            width: 53px;
            height: 38px;
            border-radius: 15px;
            background: #111318cc;
            border-color: BlobTheme.docs;
            border-width: 3px;
            Rectangle {
                x: 57px;
                y: 0px;
                width: 53px;
                height: 38px;
                border-radius: 15px;
                background: #111318cc;
                border-color: BlobTheme.docs;
                border-width: 3px;
            }
            Rectangle { x: 48px; y: 16px; width: 12px; height: 4px; background: BlobTheme.docs; }
        }

        if root.accessory == "wrench": Text {
            x: 151px;
            y: 27px;
            width: 48px;
            height: 57px;
            text: "⚙";
            color: BlobTheme.system;
            font-size: 38px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.accessory == "pencil": Text {
            x: 151px;
            y: 27px;
            width: 50px;
            height: 58px;
            text: "✎";
            color: BlobTheme.notes;
            font-size: 39px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 14px;
        y: 207px;
        width: 196px;
        height: 22px;
        text: root.name;
        color: root.focused ? BlobTheme.text : BlobTheme.text-muted;
        font-size: 15px;
        font-weight: root.focused ? 600 : 500;
        horizontal-alignment: center;
    }

    Text {
        x: 14px;
        y: 228px;
        width: 196px;
        height: 18px;
        text: root.status == "" ? root.role : root.role + " · " + root.status;
        color: BlobTheme.text-faint;
        font-size: 10px;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}
